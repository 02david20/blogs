---
import ToolLayout from "../../../layouts/ToolLayout.astro";
import { toolBySlug } from "../../../lib/tools";

const meta = toolBySlug("cron-generator")!;
---

<ToolLayout
  title={meta.title}
  tagline={meta.tagline}
  description={meta.description}
  related={["unix-timestamp", "regex-tester", "json-formatter"]}
>
  <Fragment slot="app">
    <div class="tool-panel">
      <div class="cron-fields">
        <div class="tool-field">
          <label for="cron-minute">Minute (0–59)</label>
          <input id="cron-minute" class="tool-input" type="text" value="*" data-field="minute" spellcheck="false" autocomplete="off" />
          <div class="cron-chips" data-field="minute">
            <button type="button" class="tool-btn cron-chip" data-value="*">*</button>
            <button type="button" class="tool-btn cron-chip" data-value="0">0</button>
            <button type="button" class="tool-btn cron-chip" data-value="*/5">*/5</button>
            <button type="button" class="tool-btn cron-chip" data-value="*/15">*/15</button>
            <button type="button" class="tool-btn cron-chip" data-value="*/30">*/30</button>
          </div>
        </div>

        <div class="tool-field">
          <label for="cron-hour">Hour (0–23)</label>
          <input id="cron-hour" class="tool-input" type="text" value="*" data-field="hour" spellcheck="false" autocomplete="off" />
          <div class="cron-chips" data-field="hour">
            <button type="button" class="tool-btn cron-chip" data-value="*">*</button>
            <button type="button" class="tool-btn cron-chip" data-value="0">0</button>
            <button type="button" class="tool-btn cron-chip" data-value="9">9</button>
            <button type="button" class="tool-btn cron-chip" data-value="*/2">*/2</button>
            <button type="button" class="tool-btn cron-chip" data-value="*/6">*/6</button>
          </div>
        </div>

        <div class="tool-field">
          <label for="cron-dom">Day of month (1–31)</label>
          <input id="cron-dom" class="tool-input" type="text" value="*" data-field="dom" spellcheck="false" autocomplete="off" />
          <div class="cron-chips" data-field="dom">
            <button type="button" class="tool-btn cron-chip" data-value="*">*</button>
            <button type="button" class="tool-btn cron-chip" data-value="1">1</button>
            <button type="button" class="tool-btn cron-chip" data-value="15">15</button>
            <button type="button" class="tool-btn cron-chip" data-value="*/2">*/2</button>
          </div>
        </div>

        <div class="tool-field">
          <label for="cron-month">Month (1–12)</label>
          <input id="cron-month" class="tool-input" type="text" value="*" data-field="month" spellcheck="false" autocomplete="off" />
          <div class="cron-chips" data-field="month">
            <button type="button" class="tool-btn cron-chip" data-value="*">*</button>
            <button type="button" class="tool-btn cron-chip" data-value="1">1</button>
            <button type="button" class="tool-btn cron-chip" data-value="6">6</button>
            <button type="button" class="tool-btn cron-chip" data-value="12">12</button>
          </div>
        </div>

        <div class="tool-field">
          <label for="cron-dow">Day of week (0–6, 0=Sun)</label>
          <input id="cron-dow" class="tool-input" type="text" value="*" data-field="dow" spellcheck="false" autocomplete="off" />
          <div class="cron-chips" data-field="dow">
            <button type="button" class="tool-btn cron-chip" data-value="*">*</button>
            <button type="button" class="tool-btn cron-chip" data-value="1-5">1-5</button>
            <button type="button" class="tool-btn cron-chip" data-value="0">0</button>
            <button type="button" class="tool-btn cron-chip" data-value="6,0">6,0</button>
          </div>
        </div>
      </div>

      <div class="tool-field cron-expression-field">
        <label for="cron-output">Cron expression</label>
        <input id="cron-output" class="tool-input" type="text" readonly spellcheck="false" />
      </div>

      <p id="cron-explanation" class="cron-explanation" aria-live="polite"></p>

      <div class="tool-toolbar">
        <button type="button" id="cron-copy" class="tool-btn tool-btn--primary">Copy expression</button>
      </div>

      <div class="tool-toolbar cron-presets">
        <span class="cron-presets__label">Presets:</span>
        <button type="button" class="tool-btn" data-preset="0 * * * *">Every hour</button>
        <button type="button" class="tool-btn" data-preset="*/15 * * * *">Every 15 minutes</button>
        <button type="button" class="tool-btn" data-preset="0 0 * * *">Daily at midnight</button>
        <button type="button" class="tool-btn" data-preset="0 9 * * 1-5">Weekdays at 9am</button>
        <button type="button" class="tool-btn" data-preset="0 0 * * 0">Weekly on Sunday</button>
        <button type="button" class="tool-btn" data-preset="0 0 1 * *">Monthly on the 1st</button>
      </div>
    </div>
  </Fragment>

  <h2>The five cron fields</h2>
  <p>This tool targets standard 5-field cron syntax, left to right:</p>
  <ul>
    <li><strong>Minute</strong> — 0 through 59</li>
    <li><strong>Hour</strong> — 0 through 23, 24-hour clock</li>
    <li><strong>Day of month</strong> — 1 through 31</li>
    <li><strong>Month</strong> — 1 through 12</li>
    <li><strong>Day of week</strong> — 0 through 6</li>
  </ul>
  <p>
    The day-of-week field has a well-known gotcha: some cron implementations also accept{" "}
    <code>7</code> as a second name for Sunday, so both <code>0</code> and <code>7</code> mean the
    same day. This tool uses the standard convention of <code>0 = Sunday</code>, <code>1 = Monday</code>,
    through <code>6 = Saturday</code>, and treats a stray <code>7</code> in a list or range as Sunday
    too when explaining an expression.
  </p>
  <p>
    Each field also accepts <code>*</code> (every value), a step (<code>*/N</code>), a range (
    <code>A-B</code>), or a comma-separated list (<code>A,B,C</code>) — and these can combine, e.g.{" "}
    <code>1-5/2</code>.
  </p>

  <h2>Syntax this tool targets</h2>
  <p>
    This generates <strong>standard Unix <code>cron(8)</code></strong> syntax — the 5-field format
    used by <code>crontab</code> on Linux and macOS. It does not claim to match every cron-like
    dialect out there. The most common divergence is Quartz (used by many Java schedulers and some CI
    systems), which uses <strong>6 or 7 fields</strong> — it inserts a seconds field before the
    minute field and adds an optional year field at the end — and supports a <code>?</code> character
    in the day-of-month/day-of-week fields to mean "no specific value," which standard cron doesn't
    have. If you're pasting an expression into a Quartz-based scheduler, add a seconds field and don't
    assume the two are interchangeable.
  </p>

  <h2>Examples</h2>
  <p>This tool's explanation feature turns each expression into a sentence:</p>
  <ul>
    <li><code>0 * * * *</code> → <em>"At minute 0 past every hour."</em> — runs once every hour, on the hour.</li>
    <li><code>0 0 * * *</code> → <em>"At 00:00."</em> — runs once a day, at midnight.</li>
    <li><code>0 9 * * 1-5</code> → <em>"At minute 0 past hour 9, Monday through Friday."</em> — runs once a day at 9am, but only Monday through Friday.</li>
  </ul>
</ToolLayout>

<style>
  .cron-fields {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
  }

  .cron-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .cron-chip {
    padding: 0.2rem 0.55rem;
    min-height: auto;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
  }

  .cron-expression-field {
    margin-top: var(--space-5);
  }

  .cron-expression-field input {
    font-size: var(--text-md);
    text-align: center;
    color: var(--text);
  }

  .cron-explanation {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .cron-presets {
    margin-top: var(--space-3);
  }

  .cron-presets__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-faint);
  }
</style>

<script>
  import { copyToClipboard } from "../../../lib/tools-client";

  const minuteInput = document.getElementById("cron-minute") as HTMLInputElement;
  const hourInput = document.getElementById("cron-hour") as HTMLInputElement;
  const domInput = document.getElementById("cron-dom") as HTMLInputElement;
  const monthInput = document.getElementById("cron-month") as HTMLInputElement;
  const dowInput = document.getElementById("cron-dow") as HTMLInputElement;
  const outputInput = document.getElementById("cron-output") as HTMLInputElement;
  const explanationEl = document.getElementById("cron-explanation") as HTMLParagraphElement;
  const copyBtn = document.getElementById("cron-copy") as HTMLButtonElement;

  const MONTH_NAMES = [
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December",
  ];
  const DOW_NAMES = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];

  type FieldKind = "every" | "exact" | "step" | "range" | "list" | "other";

  interface ParsedField {
    kind: FieldKind;
    raw: string;
    numbers?: number[];
    step?: number;
    range?: [number, number];
  }

  function parseField(value: string): ParsedField {
    const v = value.trim();
    if (v === "*") return { kind: "every", raw: v };

    let m = v.match(/^\*\/(\d+)$/);
    if (m) return { kind: "step", raw: v, step: Number(m[1]) };

    m = v.match(/^(\d+)-(\d+)$/);
    if (m) return { kind: "range", raw: v, range: [Number(m[1]), Number(m[2])] };

    if (/^\d+(,\d+)*$/.test(v)) {
      const numbers = v.split(",").map(Number);
      return numbers.length > 1
        ? { kind: "list", raw: v, numbers }
        : { kind: "exact", raw: v, numbers };
    }

    return { kind: "other", raw: v };
  }

  function joinWithAnd(items: string[]): string {
    if (items.length === 1) return items[0];
    if (items.length === 2) return `${items[0]} and ${items[1]}`;
    return `${items.slice(0, -1).join(", ")}, and ${items[items.length - 1]}`;
  }

  function describeTime(minute: ParsedField, hour: ParsedField, hasOtherRestriction: boolean): string {
    if (minute.kind === "step" && hour.kind === "every") {
      return `Every ${minute.step} minute${minute.step === 1 ? "" : "s"}`;
    }
    if (hour.kind === "step" && minute.kind === "exact") {
      return `At minute ${minute.numbers![0]}, every ${hour.step} hour${hour.step === 1 ? "" : "s"}`;
    }
    if (minute.kind === "exact" && hour.kind === "exact") {
      if (!hasOtherRestriction) {
        const hh = String(hour.numbers![0]).padStart(2, "0");
        const mm = String(minute.numbers![0]).padStart(2, "0");
        return `At ${hh}:${mm}`;
      }
      return `At minute ${minute.numbers![0]} past hour ${hour.numbers![0]}`;
    }
    if (minute.kind === "exact" && hour.kind === "every") {
      return `At minute ${minute.numbers![0]} past every hour`;
    }
    if (minute.kind === "every" && hour.kind === "every") {
      return "Every minute";
    }
    if (minute.kind === "every" && hour.kind === "exact") {
      return `Every minute during hour ${hour.numbers![0]}`;
    }
    if (minute.kind === "step" && hour.kind === "exact") {
      return `Every ${minute.step} minutes, during hour ${hour.numbers![0]}`;
    }
    if (minute.kind === "range") {
      const [a, b] = minute.range!;
      const hourPart =
        hour.kind === "every" ? " past every hour" : hour.kind === "exact" ? `, during hour ${hour.numbers![0]}` : "";
      return `At minutes ${a}–${b}${hourPart}`;
    }
    if (minute.kind === "list") {
      const hourPart =
        hour.kind === "every" ? " past every hour" : hour.kind === "exact" ? `, during hour ${hour.numbers![0]}` : "";
      return `At minutes ${minute.numbers!.join(", ")}${hourPart}`;
    }
    return `At minute "${minute.raw}" of hour "${hour.raw}"`;
  }

  function describeDom(field: ParsedField): string | null {
    if (field.kind === "every") return null;
    if (field.kind === "exact") return `on day ${field.numbers![0]} of the month`;
    if (field.kind === "range") return `on days ${field.range![0]}–${field.range![1]} of the month`;
    if (field.kind === "list") return `on days ${field.numbers!.join(", ")} of the month`;
    return `on day-of-month "${field.raw}"`;
  }

  function describeMonth(field: ParsedField): string | null {
    if (field.kind === "every") return null;
    const name = (n: number) => MONTH_NAMES[n - 1] ?? String(n);
    if (field.kind === "exact") return `in ${name(field.numbers![0])}`;
    if (field.kind === "range") return `from ${name(field.range![0])} through ${name(field.range![1])}`;
    if (field.kind === "list") return `in ${joinWithAnd(field.numbers!.map(name))}`;
    return `in month "${field.raw}"`;
  }

  function describeDow(field: ParsedField): string | null {
    if (field.kind === "every") return null;
    const name = (n: number) => DOW_NAMES[((n % 7) + 7) % 7];
    if (field.kind === "exact") return `on ${name(field.numbers![0])}`;
    if (field.kind === "range") return `${name(field.range![0])} through ${name(field.range![1])}`;
    if (field.kind === "list") return `on ${joinWithAnd(field.numbers!.map(name))}`;
    return `on day-of-week "${field.raw}"`;
  }

  function explain(minute: string, hour: string, dom: string, month: string, dow: string): string {
    const minuteField = parseField(minute);
    const hourField = parseField(hour);
    const domField = parseField(dom);
    const monthField = parseField(month);
    const dowField = parseField(dow);

    const domRestricted = domField.kind !== "every";
    const dowRestricted = dowField.kind !== "every";
    const monthRestricted = monthField.kind !== "every";
    const hasOtherRestriction = domRestricted || dowRestricted || monthRestricted;

    let sentence = describeTime(minuteField, hourField, hasOtherRestriction);

    const domDesc = describeDom(domField);
    const dowDesc = describeDow(dowField);
    const monthDesc = describeMonth(monthField);

    const clauses: string[] = [];
    if (domRestricted && dowRestricted) {
      // Standard cron OR semantics: when both day-of-month and day-of-week are
      // restricted, a match on either field triggers the job — it's not an AND.
      clauses.push(`${domDesc} or ${dowDesc}`);
    } else if (domRestricted) {
      clauses.push(domDesc!);
    } else if (dowRestricted) {
      clauses.push(dowDesc!);
    }
    if (monthDesc) clauses.push(monthDesc);

    if (clauses.length > 0) {
      sentence += ", " + clauses.join(", ");
    }

    return sentence + ".";
  }

  function update() {
    const minute = minuteInput.value.trim() || "*";
    const hour = hourInput.value.trim() || "*";
    const dom = domInput.value.trim() || "*";
    const month = monthInput.value.trim() || "*";
    const dow = dowInput.value.trim() || "*";

    outputInput.value = [minute, hour, dom, month, dow].join(" ");
    explanationEl.textContent = explain(minute, hour, dom, month, dow);
  }

  [minuteInput, hourInput, domInput, monthInput, dowInput].forEach((el) => {
    el.addEventListener("input", update);
  });

  document.querySelectorAll<HTMLDivElement>(".cron-chips").forEach((group) => {
    const field = group.dataset.field;
    const targetInput = document.querySelector<HTMLInputElement>(`[data-field="${field}"].tool-input`);
    group.querySelectorAll<HTMLButtonElement>(".cron-chip").forEach((chip) => {
      chip.addEventListener("click", () => {
        if (!targetInput) return;
        targetInput.value = chip.dataset.value ?? "*";
        update();
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const preset = btn.dataset.preset;
      if (!preset) return;
      const [minute, hour, dom, month, dow] = preset.split(" ");
      minuteInput.value = minute;
      hourInput.value = hour;
      domInput.value = dom;
      monthInput.value = month;
      dowInput.value = dow;
      update();
    });
  });

  copyBtn.addEventListener("click", () => copyToClipboard(outputInput.value, copyBtn));

  update();
</script>
