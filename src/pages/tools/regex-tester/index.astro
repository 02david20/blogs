---
import ToolLayout from "../../../layouts/ToolLayout.astro";
import { toolBySlug } from "../../../lib/tools";

const meta = toolBySlug("regex-tester")!;
---

<ToolLayout
  title={meta.title}
  tagline={meta.tagline}
  description={meta.description}
  related={["json-formatter", "url-encoder", "jwt-decoder"]}
>
  <Fragment slot="app">
    <div class="tool-panel">
      <div class="tool-toolbar tool-toolbar--top">
        <div class="tool-field regex-pattern-field">
          <label for="regex-pattern">Pattern</label>
          <input
            id="regex-pattern"
            class="tool-input"
            type="text"
            placeholder="e.g. \d+"
            spellcheck="false"
            autocomplete="off"
          />
        </div>
        <div class="tool-field regex-flags-field">
          <label for="regex-flags">Flags</label>
          <input
            id="regex-flags"
            class="tool-input"
            type="text"
            value="g"
            spellcheck="false"
            autocomplete="off"
          />
        </div>
      </div>

      <div class="tool-field">
        <label for="regex-test">Test string</label>
        <textarea
          id="regex-test"
          class="tool-textarea"
          placeholder="Paste text to test the pattern against…"
          spellcheck="false"
        ></textarea>
      </div>

      <p id="regex-error" class="tool-error" role="alert" hidden></p>

      <div class="tool-field">
        <p class="tool-field__label" id="regex-highlight-label">Highlighted matches</p>
        <div
          id="regex-highlight"
          class="tool-textarea regex-highlight"
          aria-live="polite"
          aria-labelledby="regex-highlight-label"
        ></div>
      </div>

      <div class="tool-toolbar">
        <button type="button" id="regex-copy" class="tool-btn tool-btn--primary">Copy regex</button>
        <button type="button" id="regex-clear" class="tool-btn">Clear</button>
        <span id="regex-count" class="regex-count" aria-live="polite"></span>
      </div>

      <div class="tool-toolbar regex-presets">
        <span class="regex-presets__label">Examples:</span>
        <button type="button" class="tool-btn" data-preset="email">Email-like</button>
        <button type="button" class="tool-btn" data-preset="url">URL</button>
        <button type="button" class="tool-btn" data-preset="digits">Digits only</button>
        <button type="button" class="tool-btn" data-preset="trim">Leading/trailing whitespace</button>
      </div>
    </div>

    <div class="tool-panel">
      <p class="tool-field__label">Capture groups (first match)</p>
      <div id="regex-groups" class="regex-groups"></div>
    </div>
  </Fragment>

  <h2>Regex syntax, briefly</h2>
  <p>A compact reference for the pieces you'll use most:</p>
  <ul>
    <li><code>\d</code> <code>\w</code> <code>\s</code> — digit, word character, whitespace (capitalized to negate: <code>\D</code> <code>\W</code> <code>\S</code>).</li>
    <li><code>[abc]</code> a character class — any one of <code>a</code>, <code>b</code>, or <code>c</code>. <code>[^abc]</code> negates it.</li>
    <li><code>.</code> matches any character except a line terminator (unless the <code>s</code> flag is set).</li>
    <li><code>* + ? {`{n,m}`}</code> — quantifiers: zero-or-more, one-or-more, zero-or-one, and an explicit repeat range.</li>
    <li><code>^</code> <code>$</code> — start and end of the string (or of each line, with the <code>m</code> flag).</li>
    <li><code>\b</code> a word boundary — the position between a word character and a non-word character.</li>
  </ul>

  <h2>Common flags</h2>
  <ul>
    <li><code>g</code> — global: find all matches instead of stopping at the first.</li>
    <li><code>i</code> — case-insensitive matching.</li>
    <li><code>m</code> — multiline: <code>^</code> and <code>$</code> match at line boundaries, not just string boundaries.</li>
    <li><code>s</code> — dotAll: lets <code>.</code> match line terminators too.</li>
    <li><code>u</code> — unicode mode: treats the pattern as a sequence of Unicode code points (fixes surrogate-pair handling) and tightens escape-sequence validation.</li>
    <li><code>y</code> — sticky: matches only starting at <code>lastIndex</code>, without scanning ahead.</li>
  </ul>

  <h2>Capturing groups</h2>
  <p>
    <code>(...)</code> is a numbered capturing group — the first one in the pattern becomes{" "}
    <code>match[1]</code>, the second <code>match[2]</code>, and so on. <code>(?&lt;name&gt;...)</code>{" "}
    is a named group, accessible as <code>match.groups.name</code>. <code>(?:...)</code> is a{" "}
    <strong>non-capturing</strong> group — useful for grouping alternatives or applying a quantifier
    without adding an entry to the numbered results.
  </p>

  <h2>Lookahead and lookbehind</h2>
  <ul>
    <li><code>(?=...)</code> — positive lookahead: matches if followed by the pattern, without consuming it.</li>
    <li><code>(?!...)</code> — negative lookahead: matches if <em>not</em> followed by the pattern.</li>
    <li><code>(?&lt;=...)</code> — positive lookbehind: matches if preceded by the pattern.</li>
    <li><code>(?&lt;!...)</code> — negative lookbehind: matches if <em>not</em> preceded by the pattern.</li>
  </ul>
  <p>
    Lookbehind is a newer addition to JavaScript's regex engine (ES2018) — it works in all current
    evergreen browsers, but if your code needs to run in much older JavaScript environments, check
    support before relying on it.
  </p>

  <h2>This is JavaScript's regex engine</h2>
  <p>
    This tool builds patterns with JavaScript's native <code>RegExp</code>, not PCRE, POSIX ERE, or
    .NET's regex flavor — and they aren't identical. A pattern that behaves one way in Python's{" "}
    <code>re</code> module or a POSIX tool like <code>grep -E</code> can behave differently — or fail
    to compile — here. A few concrete gaps: JavaScript has no POSIX bracket expressions like{" "}
    <code>[[:alpha:]]</code>, no <code>\A</code>/<code>\Z</code> string anchors (use <code>^</code>/<code>$</code>{" "}
    without the <code>m</code> flag, or <code>\b</code>), and no recursive patterns or possessive
    quantifiers. If you're testing a pattern meant for another tool or language, verify it there too.
  </p>

  <h2>Example patterns</h2>
  <pre><code>{`\\d+                                    → one or more digits
[\\w.+-]+@[\\w-]+\\.[a-zA-Z]{2,}         → a loose email-like match
https?:\\/\\/[^\\s]+                    → an http(s) URL up to the next whitespace
^\\s+|\\s+$                             → leading or trailing whitespace
(?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})  → a named-group date match`}</code></pre>
</ToolLayout>

<style>
  .regex-pattern-field {
    flex: 2 1 20rem;
  }

  .regex-flags-field {
    flex: 0 1 8rem;
  }

  .regex-highlight {
    white-space: pre-wrap;
    word-break: break-word;
    min-height: 6rem;
    cursor: text;
  }

  .tool-field__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-faint);
    margin: 0 0 var(--space-2);
  }

  .regex-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-faint);
    margin-left: auto;
  }

  .regex-presets {
    margin-top: var(--space-3);
  }

  .regex-presets__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  .regex-groups ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: 1.1em;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .regex-groups p {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
  }
</style>

<script>
  import { copyToClipboard, escapeHtml, setError } from "../../../lib/tools-client";

  const patternInput = document.getElementById("regex-pattern") as HTMLInputElement;
  const flagsInput = document.getElementById("regex-flags") as HTMLInputElement;
  const testInput = document.getElementById("regex-test") as HTMLTextAreaElement;
  const highlightEl = document.getElementById("regex-highlight") as HTMLDivElement;
  const errorEl = document.getElementById("regex-error") as HTMLParagraphElement;
  const countEl = document.getElementById("regex-count") as HTMLSpanElement;
  const groupsEl = document.getElementById("regex-groups") as HTMLDivElement;
  const copyBtn = document.getElementById("regex-copy") as HTMLButtonElement;
  const clearBtn = document.getElementById("regex-clear") as HTMLButtonElement;

  interface Preset {
    pattern: string;
    flags: string;
    test: string;
  }

  const presets: Record<string, Preset> = {
    email: {
      pattern: "[\\w.+-]+@[\\w-]+\\.[a-zA-Z]{2,}",
      flags: "g",
      test: "Contact us at hello@example.com or support@sub.example.co.uk for help.",
    },
    url: {
      pattern: "https?:\\/\\/[^\\s]+",
      flags: "g",
      test: "Visit https://example.com/path?query=1 or http://test.org for more info.",
    },
    digits: {
      pattern: "\\d+",
      flags: "g",
      test: "Order #4521 shipped on 2024-03-15, tracking number 998877.",
    },
    trim: {
      pattern: "^\\s+|\\s+$",
      flags: "g",
      test: "   trim the leading and trailing spaces please   ",
    },
  };

  function clearOutputs() {
    highlightEl.innerHTML = "";
    countEl.textContent = "";
    groupsEl.innerHTML = "";
  }

  function renderGroups(pattern: string, flags: string, testStr: string) {
    groupsEl.innerHTML = "";
    let execRegex: RegExp;
    try {
      execRegex = new RegExp(pattern, flags);
    } catch {
      groupsEl.innerHTML = "<p>No capturing groups.</p>";
      return;
    }

    const firstMatch = execRegex.exec(testStr);
    if (!firstMatch) {
      groupsEl.innerHTML = "<p>No match found.</p>";
      return;
    }

    const items: string[] = [];
    for (let i = 1; i < firstMatch.length; i++) {
      const value = firstMatch[i];
      items.push(
        `<li><code>${i}</code>: ${value !== undefined ? escapeHtml(value) : "<em>undefined</em>"}</li>`
      );
    }
    if (firstMatch.groups) {
      for (const [name, value] of Object.entries(firstMatch.groups)) {
        items.push(
          `<li><code>${escapeHtml(name)}</code>: ${
            value !== undefined ? escapeHtml(value) : "<em>undefined</em>"
          }</li>`
        );
      }
    }

    groupsEl.innerHTML = items.length ? `<ul>${items.join("")}</ul>` : "<p>No capturing groups.</p>";
  }

  function process() {
    const pattern = patternInput.value;
    const flags = flagsInput.value;
    const testStr = testInput.value;

    if (pattern === "") {
      highlightEl.innerHTML = escapeHtml(testStr);
      countEl.textContent = "";
      groupsEl.innerHTML = "";
      setError(errorEl, null);
      return;
    }

    let globalRegex: RegExp;
    try {
      // Validate the pattern against the user's exact flags first, so a bad
      // combination (e.g. an invalid flag) surfaces the real browser message.
      new RegExp(pattern, flags);
      const globalFlags = flags.includes("g") ? flags : flags + "g";
      globalRegex = new RegExp(pattern, globalFlags);
    } catch (err) {
      setError(errorEl, err instanceof Error ? err.message : "Invalid regular expression.");
      clearOutputs();
      return;
    }

    setError(errorEl, null);

    let html = "";
    let lastIndex = 0;
    let count = 0;
    for (const match of testStr.matchAll(globalRegex)) {
      count++;
      const start = match.index ?? 0;
      const end = start + match[0].length;
      html += escapeHtml(testStr.slice(lastIndex, start));
      html += `<mark class="tool-match">${escapeHtml(match[0])}</mark>`;
      lastIndex = end;
    }
    html += escapeHtml(testStr.slice(lastIndex));

    highlightEl.innerHTML = html;
    countEl.textContent = count === 1 ? "1 match" : `${count} matches`;

    renderGroups(pattern, flags, testStr);
  }

  patternInput.addEventListener("input", process);
  flagsInput.addEventListener("input", process);
  testInput.addEventListener("input", process);

  copyBtn.addEventListener("click", () =>
    copyToClipboard(`/${patternInput.value}/${flagsInput.value}`, copyBtn)
  );

  clearBtn.addEventListener("click", () => {
    patternInput.value = "";
    flagsInput.value = "g";
    testInput.value = "";
    clearOutputs();
    setError(errorEl, null);
    patternInput.focus();
  });

  document.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const preset = presets[btn.dataset.preset ?? ""];
      if (!preset) return;
      patternInput.value = preset.pattern;
      flagsInput.value = preset.flags;
      testInput.value = preset.test;
      process();
    });
  });

  process();
</script>
