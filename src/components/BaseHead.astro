---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

import defaultOg from "../assets/site/default-og.jpg";
import { SITE } from "../lib/site";
import { url } from "../lib/url";

import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  type?: "website" | "article";
  publishedDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  type = "website",
  publishedDate,
  updatedDate,
  tags = [],
  noindex = false,
} = Astro.props;

/* Astro.url.pathname already carries the `/blogs` base, so this produces a
   correct absolute URL — the old build emitted `//blogs/...` here. */
const canonical = new URL(Astro.url.pathname, Astro.site);

const ogImage = await getImage({
  src: image ?? defaultOg,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpeg",
});
const ogImageUrl = new URL(ogImage.src, Astro.site);

const pageTitle = title === SITE.title ? SITE.title : `${title} — ${SITE.title}`;

const jsonLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        image: ogImageUrl.href,
        datePublished: publishedDate?.toISOString(),
        dateModified: (updatedDate ?? publishedDate)?.toISOString(),
        keywords: tags.join(", "),
        author: { "@type": "Person", name: SITE.author },
        publisher: { "@type": "Person", name: SITE.author },
        mainEntityOfPage: { "@type": "WebPage", "@id": canonical.href },
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: SITE.title,
        description: SITE.description,
        url: new URL(url("/"), Astro.site).href,
      };
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="generator" content={Astro.generator} />

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical.href} />

<!-- The browser chrome should match whichever theme is actually showing. -->
<meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#131211" media="(prefers-color-scheme: dark)" />

<link rel="icon" href={url("/favicon.ico").replace(/\/$/, "")} sizes="32x32" />
<link rel="apple-touch-icon" href={url("/pwa/icons/icon-512.png").replace(/\/$/, "")} />
<link rel="manifest" href={url("/manifest.webmanifest").replace(/\/$/, "")} />

<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.title} — RSS`}
  href={new URL(url("/feed.xml").replace(/\/$/, ""), Astro.site).href}
/>

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImageUrl.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

{publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
{type === "article" && <meta property="article:author" content={SITE.author} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl.href} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
