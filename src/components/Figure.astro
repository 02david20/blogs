---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Rendered width in px. Defaults to the image's intrinsic width. */
  width?: number;
}

const { src, alt, caption, width } = Astro.props;
const w = Math.min(width ?? src.width, src.width);
---

<figure>
  <Image src={src} alt={alt} width={w} densities={[1, 2]} loading="lazy" decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
