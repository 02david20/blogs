---
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";

import BaseLayout from "./BaseLayout.astro";
import PostMeta from "../components/PostMeta.astro";
import TableOfContents from "../components/TableOfContents.astro";
import Mermaid from "../components/Mermaid.astro";
import { postUrl, tagUrl } from "../lib/url";
import "../styles/prose.css";

type Post = CollectionEntry<"blog">;

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  readingTime?: number;
  prev?: Post;
  next?: Post;
  related?: Post[];
}

const { post, headings, readingTime, prev, next, related = [] } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage } = post.data;
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  type="article"
  publishedDate={pubDate}
  updatedDate={updatedDate}
  tags={tags}
>
  <article class="post">
    <div class="post__grid">
      <header class="post__header">
        {
          tags.length > 0 && (
            <ul class="tag-list post__tags">
              {tags.map((tag) => (
                <li>
                  <a class="tag" href={tagUrl(tag)}>
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          )
        }

        <h1 class="post__title">{title}</h1>
        <p class="post__lede">{description}</p>

        <PostMeta date={pubDate} readingTime={readingTime} format="long" class="post__meta" />
        {
          updatedDate && (
            <p class="post__updated">
              Updated{" "}
              <time datetime={updatedDate.toISOString()}>
                {new Intl.DateTimeFormat("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                  timeZone: "UTC",
                }).format(updatedDate)}
              </time>
            </p>
          )
        }
      </header>

      <aside class="post__aside">
        <TableOfContents headings={headings} />
      </aside>

      <div class="post__body prose">
        <slot />
      </div>

      <footer class="post__footer">
        {
          (prev || next) && (
            <nav class="pager" aria-label="More posts">
              {prev ? (
                <a class="pager__link pager__link--prev" href={postUrl(prev.id)} rel="prev">
                  <span class="eyebrow">Previous</span>
                  <span class="pager__title">{prev.data.title}</span>
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a class="pager__link pager__link--next" href={postUrl(next.id)} rel="next">
                  <span class="eyebrow">Next</span>
                  <span class="pager__title">{next.data.title}</span>
                </a>
              )}
            </nav>
          )
        }

        {
          related.length > 0 && (
            <section class="related">
              <div class="section-title">
                <h2>Related reading</h2>
              </div>
              <ul class="related__list">
                {related.map((item) => (
                  <li class="related__item">
                    <a class="related__link" href={postUrl(item.id)}>
                      {item.data.title}
                    </a>
                    <p class="related__desc">{item.data.description}</p>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </footer>
    </div>
  </article>

  <Mermaid />
</BaseLayout>

<style>
  .post {
    padding-top: var(--space-8);
  }

  .post__grid {
    width: 100%;
    max-width: 66rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    gap: var(--space-6);
    grid-template-areas:
      "header"
      "toc"
      "body"
      "footer";
  }

  .post__header {
    grid-area: header;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--measure);
  }

  .post__tags {
    margin-bottom: calc(var(--space-1) * -1);
  }

  .post__title {
    font-size: var(--text-4xl);
    font-weight: 620;
    letter-spacing: var(--tracking-tight);
  }

  .post__lede {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: var(--leading-prose);
    color: var(--text-muted);
    max-width: 58ch;
  }

  .post__meta {
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
  }

  .post__updated {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  .post__aside {
    grid-area: toc;
  }

  .post__body {
    grid-area: body;
  }

  .post__footer {
    grid-area: footer;
    margin-top: var(--space-10);
    max-width: var(--measure);
  }

  /* --- Pager ------------------------------------------------------------ */

  .pager {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .pager__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text);
  }

  .pager__link:hover {
    border-color: var(--accent);
  }

  .pager__link:hover .pager__title {
    color: var(--accent);
  }

  .pager__title {
    font-size: var(--text-md);
    font-weight: 550;
    line-height: var(--leading-snug);
  }

  .pager__link--next {
    text-align: right;
  }

  /* --- Related ---------------------------------------------------------- */

  .related {
    margin-top: var(--space-10);
  }

  .related__list {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related__link {
    font-size: var(--text-md);
    font-weight: 550;
    color: var(--text);
    text-decoration: none;
  }

  .related__link:hover {
    color: var(--accent);
  }

  .related__desc {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--text-muted);
    max-width: 60ch;
  }

  @media (min-width: 40rem) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* --- Desktop: article left, sticky TOC rail right --------------------- */
  @media (min-width: 72rem) {
    .post {
      padding-top: var(--space-10);
    }

    .post__grid {
      grid-template-columns: minmax(0, 1fr) 15rem;
      column-gap: var(--space-10);
      align-items: start;
      grid-template-areas:
        "header ."
        "body   toc"
        "footer .";
    }

    .post__aside {
      position: sticky;
      /* Clears the sticky site header. */
      top: 6rem;
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .pager__link,
    .pager__title,
    .related__link {
      transition:
        color var(--duration-fast) var(--ease),
        border-color var(--duration-fast) var(--ease);
    }
  }
</style>
